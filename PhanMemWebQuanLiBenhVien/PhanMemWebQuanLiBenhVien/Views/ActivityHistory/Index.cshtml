@model List<ActivityHistory>

<link rel="stylesheet" href="~/css/Patient/Index.css" />
@if (User.IsInRole("Admin") || User.IsInRole("QuanLiNhanSu"))
{
    <form id="myForm" method="post" class="d-flex align-items-center gap-3" onsubmit="return validateDates()" style="margin-top: 30px">
        <div class="input-group">
            <label class="input-group-text" for="">Ngày bắt đầu</label>
            <input type="date" id="startDate" name="startDate" class="form-control me-2" placeholder="Từ ngày" aria-label="Từ ngày">
        </div>
        <div class="input-group">
            <label class="input-group-text" for="">Ngày kết thúc</label>
            <input type="date" id="endDate" name="endDate" class="form-control me-2" placeholder="Đến ngày" aria-label="Đến ngày">
        </div>
        <div class="input-group">
            <label class="input-group-text" for="SearchRole">Vai trò</label>
            <select id="SearchRole" name="SearchRole" class="form-select" asp-items="@ViewBag.ListRole">
                <option value="NoFilter">Tìm kiếm theo vai trò nhân sự</option>
            </select>
        </div>
        <div class="input-group">
            <label class="input-group-text" for="SearchExecutorID">ID</label>
            <input type="number" id="SearchExecutorID" name="SearchExecutorID"
                   class="form-control" placeholder="Nhập ID nhân sự"/>
        </div>
        <button type="submit" class="btn btn-primary text-center" style="width: 40px; height: 40px">
            <i class="bi bi-search"></i> 
        </button>
    </form>
}
@if (Model == null || Model.Count <= 0)
{
    <p class="text-muted">Không có hoạt động nào.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="">
            <tr>
                <th class="align-content-center">Executor ID</th>
                <th class="align-content-center">Executor UserName</th>
                <th class="align-content-center">Role</th>
                <th class="align-content-center">Object ID</th>
                <th class="align-content-center">Activity</th>
                <th class="align-content-center">Details</th>
                <th class="align-content-center">Activity Time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ah in Model)
            {
                <tr>
                    <td class="align-content-center">@ah.MemberId</td>
                    <td class="align-content-center">@ah.MemberName</td>
                    <td class="align-content-center">@ah.MemberRole</td>
                    <td class="align-content-center">@ah.ObjectId</td>
                    <td class="align-content-center">@ah.Activity</td>
                    <td class="align-content-center">
                        @if (ah.UpdateDetails!=null)
                        {
                            var ls = ah.UpdateDetails.Split(",");                           
                            int count = ls.Count();
                            int currentIndex = 0;
                            @foreach (string s in ls)
                            {
                                @s
                                if (currentIndex < count - 2)
                                {
                                    <br />
                                }
                                currentIndex++;
                            }   
                        }
                        else
                        {
                            <p>N/A</p>
                        }
                    </td>
                    <td class="align-content-center">@ah.ActivityTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>
}

<style>
    .table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
    }

    .table th, .table td {
        text-align: center;
        padding: 10px;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f9f9f9;
    }

    .table-dark {
        background-color: #343a40;
        color: #ffffff;
    }

    .text-muted {
        color: #6c757d;
        font-style: italic;
    }
</style>

<script>
    document.getElementById("myForm").addEventListener("submit", function(e) {
        const input = document.getElementById("SearchExecutorID");
        if (!input.value) {
            input.value = -1;
        }
    });
</script>
<script>
    function validateDates() {
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;
        if ((startDate && !endDate) || (!startDate && endDate)) {
            alert('Vui lòng chọn cả ngày bắt đầu và ngày kết thúc.');
            return false;
        }
        if (startDate && endDate && startDate > endDate) {
            alert('Ngày bắt đầu phải bé hơn hoặc bằng ngày kết thúc.');
            return false;
        }
        return true;
    }
</script>