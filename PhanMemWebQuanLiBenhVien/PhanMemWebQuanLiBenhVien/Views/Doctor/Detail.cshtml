@using PhanMemWebQuanLiBenhVien.DataAccess.Repository.Interfaces
@inject IUnitOfWork UnitOfWork
@model Doctor
@{
	ViewData["Title"] = "Chi Tiết Bác Sĩ";
	var chamcongs = UnitOfWork.ChamCongRepository.GetAll(u => u.DoctorId == Model.DoctorId)
			.GroupBy(u => new { u.Time.Year, u.Time.Month })
			.Select(g => new
			{
				Year = g.Key.Year,
				Month = g.Key.Month,
				TotalAttendance = g.Count()
			}).ToList();
}
<link rel="stylesheet" href="~/css/Doctor/Detail.css"/>
<div>
	<h1 class="text-primary text-center fs-1 fw-bolder">Chi tiết</h1>
	<div class="mt-5 doctor-info">
		<p class="text-primary fw-bold">ID: @Model.DoctorId</p>
		<p class ="text-primary fw-bold">Tên bác sĩ: @Model.DoctorName</pc>
		<p class="text-primary fw-bold">CCCD: @Model.DoctorCCCD</p>
		<p class="text-primary fw-bold">Tuổi: @Model.DoctorAge</p>
		<p class="text-primary fw-bold">Giới tính: @Model.DoctorGender.ToString()</p>
		<p class="text-primary fw-bold">Chuyên khoa: @Model.Profession.ProfessionName</p>
	</div>
    <div class="row">
		<div class="my-4 col col-6">
			<table class="table table-striped">
				<thead>
					<tr>
						<th>Danh sách bệnh nhân đang điều trị</th>
					</tr>
				</thead>
				<tbody>
					@{
						if (Model.PatientList.Count != 0)
						{
							foreach (var patient in Model.PatientList)
							{
								<tr>
									<td><a href="@Url.Action("DoctorPatientDetail", "Doctor", new {PatientId = patient.PatientId})" class="text-white btn btn-primary">@patient.Name</a></td>
								</tr>
							}
						}
						else
						{
							<tr>
								<td>Trống.</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
		<div class="my-4 col col-6">
			<table class="table table-striped">
				<thead>
					<tr>
						<th>Danh sách bệnh nhân đã điều trị</th>
					</tr>
				</thead>
				<tbody>
					@{
						var patientlist = UnitOfWork.MedicalRecordRepository.GetAll(u => u.DoctorId == Model.DoctorId);
						if (patientlist.Count() != 0)
						{
							foreach (var patient in patientlist)
							{
								<tr>
									<td><a href="@Url.Action("DoctorPatientDetail", "Doctor", new {PatientId = patient.PatientId})" class="text-white btn btn-primary">@patient.PatientName</a></td>
								</tr>
							}
						}
						else
						{
							<tr>
								<td>Trống.</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
	<div>
		<h2 class="text-primary text-center">Lịch sử chấm công</h2>
		<table class="table table-bordered mt-3">
			<thead>
				<tr>
					<th width="100px">Năm</th>
					<th width="100px">Tháng</th>
					<th width="200px">Tổng số lần chấm công</th>
				</tr>
			</thead>
			<tbody>
				@if (chamcongs.Count() != 0)
				{
					foreach (var record in chamcongs)
					{
						<tr>
							<td>@record.Year</td>
							<td>@record.Month</td>
							<td>@record.TotalAttendance</td>
						</tr>
					}
				}
				else
				{
					<tr><td>Trống</td><td>Trống</td><td>Trống</td></tr>
				}
			</tbody>
		</table>
	</div>
