    if (!string.IsNullOrEmpty(dateParam))
    {
        currentDate = DateTime.Parse(dateParam);
    }
    string dayOfWeek = currentDate.ToString("dddd");
}
<link rel="stylesheet" href="~/css/WorkSchedule/Index.css"/>
<h3 class="mt-3">Thứ hiện tại: @dayOfWeek</h3>

<div class="d-flex justify-content-between">
    <a href="@Url.Action("Index", new { date = currentDate.AddDays(-1).ToString("yyyy-MM-dd") })" class="btn btn-primary decorate">
        Thứ trước đó 
    </a>
    <a href="@Url.Action("Index", new { date = currentDate.AddDays(1).ToString("yyyy-MM-dd") })" class="btn btn-primary decorate" style="margin-right: 75px">
        Thứ tiếp theo
    </a>
</div>
