@using PhanMemWebQuanLiBenhVien.DataAccess.Repository.Interfaces
@inject IUnitOfWork UnitOfWork
@model IEnumerable<PhongKham>
@{
    ViewData["Title"] = "Danh sách lịch phòng";
}

@{
    DateTime currentDate = DateTime.Today;
