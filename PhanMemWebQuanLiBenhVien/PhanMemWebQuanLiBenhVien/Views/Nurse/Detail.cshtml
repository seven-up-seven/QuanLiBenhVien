@model Nurse
@{
	ViewData["Title"] = "Chi Tiết Y Tá";
}
@using PhanMemWebQuanLiBenhVien.DataAccess.Repository.Interfaces
@inject IUnitOfWork UnitOfWork
@{
    var patientlist = UnitOfWork.MedicalRecordRepository.GetAll(u => u.NurseId == Model.NurseId);
    List<Patient> purelist = new(); 
    foreach(var pt in patientlist)
    {
        if(!purelist.Any(u=>u.PatientId == pt.PatientId))
        {
            purelist.Add(UnitOfWork.PatientRepository.Get(u=>u.PatientId == pt.PatientId)); 
        }
    }
    var chamcongs = UnitOfWork.ChamCongRepository.GetAll(u => u.NurseId == Model.NurseId)
          .GroupBy(u => new { u.Time.Year, u.Time.Month })
          .Select(g => new
          {
              Year = g.Key.Year,
              Month = g.Key.Month,
              TotalAttendance = g.Count()
          }).ToList();
}
<link rel="stylesheet" href="~/css/Nurse/Detail.css"/>
<div class="container mt-5">
    <h2 class="text-center">Chi tiết y tá</h2>

    <div class="nurse-info">
        <p><strong>ID:</strong> @Model.NurseId</p>
        <p><strong>Tên y tá:</strong> @Model.NurseName</p>
        <p><strong>CCCD:</strong> @Model.NurseCCCD</p>
        <p><strong>Tuổi:</strong> @Model.NurseAge</p>
        <p><strong>Giới tính:</strong> @Model.NurseGender.ToString()</p>
    </div>

    <div class="row">
        <div class="my-4 col col-6">
            <h4>Danh sách bệnh nhân đang điều trị</h4>
            <div class="patient-list">
                @if (Model.PatientList != null && Model.PatientList.Any())
                {
                    <ul>
                        @foreach (var patient in Model.PatientList)
                        {
                            <li>
                                <a href="@Url.Action("Detail", "Patient", new { PatientId = patient.PatientId })" class="text-decoration-none btn btn-primary">
                                    @patient.Name
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>Không có bệnh nhân nào.</p>
                }
            </div>
        </div>
        <div class="my-4 col col-6">
            <h4>Danh sách bệnh nhân đã điều trị</h4>
            <div class="patient-list">
                @if (purelist != null)
                {
                    <ul>
                        @foreach (var patient in purelist)
                        {
                            <li>
                                <a href="@Url.Action("Detail", "Patient", new { PatientId = patient.PatientId })" class="text-decoration-none btn btn-primary">
                                    @patient.Name
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>Không có bệnh nhân nào.</p>
                }
            </div>
        </div>
        <link rel="stylesheet" href="~/css/Doctor/Dash.css" />
        <h4 >Lịch sử chấm công</h4>
        <table class="table table-bordered mt-3">
            <thead>
                <tr>
                    <th width="100px">Năm</th>
                    <th width="100px">Tháng</th>
                    <th width="200px">Tổng số lần chấm công</th>
                </tr>
            </thead>
            <tbody>
                @if (chamcongs != null)
                {
                    foreach (var record in chamcongs)
                    {
                        <tr>
                            <td>@record.Year</td>
                            <td>@record.Month</td>
                            <td>@record.TotalAttendance</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="row d-flex justify-content-start mt-4">
        <a asp-controller="Nurse" asp-action="Index" class="btn text-white col-auto">Quay lại</a>
        <form method="post" asp-controller="Nurse" asp-action="Delete" asp-route-NurseId="@Model.NurseId" class="col-auto" onsubmit="return confirm('Bạn có chắc chắn muốn xoá y tá này không?');">
            <button class="btn text-white" type="submit">Xoá</button>
        </form>
    </div>
</div>

<style>
    .patient-list ul {
        list-style: none; /* Ẩn dấu chấm nếu cần */
        padding: 0;
        margin: 0;
    }

    .patient-list li {
        margin-bottom: 10px; /* Khoảng cách giữa các dòng */
        display: block; /* Hiển thị mỗi dòng là block để không chồng lên nhau */
    }

    .patient-list a {
        display: inline-block; /* Tránh bị chồng do lỗi về inline */
        padding: 5px 10px; /* Tạo khoảng cách trong nút */
        background-color: #f0f0f0; /* Nền nhẹ để nút không dính nhau */
        border-radius: 5px;
        text-decoration: none;
        
    }
</style>